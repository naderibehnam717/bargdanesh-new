generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  subscribed    Boolean   @default(true)

  accounts   Account[]
  downloads  Download[]
  favorites  Favorite[]
  sessions   Session[]
  comments   Comment[]
  activities ActivityLog[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  fileTitle String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Download {
  id        String   @id @default(cuid())
  userId    String
  fileTitle String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Setting {
  id   String @id @default("main")
  data String
}

model File {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  desc         String
  category     String
  type         String
  level        String
  author       String?
  viewUrl      String?
  downloadUrl  String?
  downloadName String?
  color        String   @default("blue")
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type])
  @@index([level])
  @@index([category])
}

model Quiz {
  id          String   @id @default(cuid())
  question    String
  options     Json
  correctIdx  Int
  explanation String?
  category    String
  level       String   @default("دانشگاهی")
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([level])
  @@index([isPublished])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String?
  quizId      String
  selectedIdx Int
  isCorrect   Boolean
  createdAt   DateTime @default(now())

  @@index([quizId])
  @@index([userId])
}

model Comment {
  id         String   @id @default(cuid())
  userId     String
  fileSlug   String
  content    String   @db.Text
  isApproved Boolean  @default(true)
  parentId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([fileSlug])
  @@index([userId])
  @@index([isApproved])
  @@index([createdAt])
  @@index([parentId])
}

model EmailLog {
  id             String   @id @default(cuid())
  subject        String
  content        String
  recipientCount Int
  sentCount      Int      @default(0)
  failedCount    Int      @default(0)
  status         String   @default("pending")
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  entityType String
  entityId   String?
  details    String?  @db.Text
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model Konkur {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String?
  year        Int
  field       String
  description String?
  questionUrl String?
  answerUrl   String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([year])
  @@index([field])
  @@index([year, field])
}
model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  icon        String   @default("📁")
  color       String   @default("blue")
  group       String   @default("general")
  description String?  @db.Text
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@index([isActive])
  @@index([group])
}
model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?  @db.Text
  content     String   @db.Text
  coverImage  String?
  category    String?
  tags        String?
  author      String?
  isPublished Boolean  @default(true)
  viewCount   Int      @default(0)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
  @@index([category])
  @@index([createdAt])
}
